# --- Admin credentials (server-side only) ---
ADMIN_USERNAME=Khyati
ADMIN_PASSWORD=replace-with-a-strong-password
# Random 32+ char string used to sign auth cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-32-byte-random-hex

# --- Vercel KV (auto-injected once you connect KV in the Vercel dashboard) ---
# KV_URL=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# KV_REST_API_READ_ONLY_TOKEN=

# --- Public site URL (used for OG metadata) ---
# NEXT_PUBLIC_SITE_URL=https://your-deployment.vercel.app
